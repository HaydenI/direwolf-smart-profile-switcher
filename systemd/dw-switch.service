[Unit]
Description=Direwolf APRS Smart Profile Daemon (Web UI + APRS RF Command + Auto RF Density)
Wants=network-online.target
After=local-fs.target network-online.target
Before=direwolf.service

[Service]
Type=simple
User=root
Group=root
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /usr/local/bin/dw-switch-daemon.py
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
